{
  "name": "warlock-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "pnpm workspace root for the @warlock.js/* package family. Private, not published. Provides one `pnpm install` and local cross-package linking during development; each package is published independently.",
  "scripts": {
    "format": "node node_modules/prettier/bin/prettier.cjs --ignore-path .prettierignore --write .",
    "format:check": "node node_modules/prettier/bin/prettier.cjs --ignore-path .prettierignore --check ."
  },
  "devDependencies": {
    "@mongez/agent-kit": "^1.3.1",
    "@anthropic-ai/tokenizer": "^0.0.4",
    "@aws-sdk/client-s3": "^3.955.0",
    "@aws-sdk/client-sesv2": "^3.1026.0",
    "@aws-sdk/lib-storage": "^3.955.0",
    "@aws-sdk/s3-request-presigner": "^3.955.0",
    "@inquirer/input": "^5.0.11",
    "@inquirer/prompts": "^8.2.0",
    "@mongez/collection": "^1.4.1",
    "@mongez/encryption": "^2.0.2",
    "@mongez/fs": "^3.0.5",
    "@mongez/scheduler": "^1.0.0",
    "@mongez/sitemap": "^1.0.2",
    "@mongez/vite": "^2.2.1",
    "@react-email/components": "^1.0.11",
    "@react-email/render": "^2.0.5",
    "@react-email/tailwind": "^2.0.7",
    "@testcontainers/mongodb": "^10.16.0",
    "@testcontainers/postgresql": "^10.16.0",
    "@types/amqplib": "^0.10.8",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.16.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "amqplib": "^0.10.9",
    "bcryptjs": "^3.0.3",
    "llama3-tokenizer-js": "^1.2.0",
    "marked-terminal": "^7.3.0",
    "mongodb": "^7.0.0",
    "nodemailer": "^8.0.5",
    "ora": "^9.3.0",
    "pg": "^8.16.3",
    "pluralize-esm": "^9.0.5",
    "prettier": "^3.9.6",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "redis": "^5.10.0",
    "socket.io": "^4.8.3",
    "testcontainers": "^11.11.0",
    "tiktoken": "^1.0.22",
    "tsx": "^4.23.13"
  },
  "dependencies": {
    "@mongez/dotenv": "^1.3.3",
    "get-tsconfig": "5.0.0-beta.5"
  },
  "agentKit": {
    "targets": [
      "claude",
      "codex"
    ]
  },
  "packageManager": "pnpm@11.24.0"
}
